# ---------------------------------------------------------------
# Absolute Best - files Git should never track
# ---------------------------------------------------------------

# Installed third-party packages (re-created by "npm install")
node_modules/

# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# Local environment files - MAY CONTAIN SECRETS, never commit
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating system junk
.DS_Store
Thumbs.db
desktop.ini

# Test / tooling caches
coverage/
.cache/
.vite/
